  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "test:login": "ng test --watch=false --browsers=ChromeHeadless --include=\"src/app/pages/login/**/*.spec.ts\" --include=\"src/app/pages/signup/**/*.spec.ts\" --include=\"src/app/services/auth.service.spec.ts\" --include=\"src/app/services/otp.service.spec.ts\" --include=\"src/app/guards/auth.guard.spec.ts\"",
    "test:session": "ng test --watch=false --browsers=ChromeHeadless --include=\"src/app/core/indexed-db.service.spec.ts\" --include=\"src/app/core/guest-migration.service.spec.ts\" --include=\"src/app/core/guest-save-prompt.service.spec.ts\" --include=\"src/app/services/local-playground-session.service.spec.ts\" --include=\"src/app/services/local-flowchart-session.service.spec.ts\" --include=\"src/app/services/playground-session.service.spec.ts\" --include=\"src/app/services/flowchart-session.service.spec.ts\" --include=\"src/app/components/playground-sessions/**/*.spec.ts\"",
    "test:editor": "ng test --watch=false --browsers=ChromeHeadless --include=\"src/app/services/js-trace.service.spec.ts\" --include=\"src/app/services/code-execution.service.spec.ts\" --include=\"src/app/components/code-editor/**/*.spec.ts\" --include=\"src/app/components/js-visualizer/**/*.spec.ts\" --include=\"src/app/components/playground-workspace/**/*.spec.ts\" --include=\"src/app/components/code-playground/**/*.spec.ts\"",
    "test:flowchart": "ng test --watch=false --browsers=ChromeHeadless --include=\"src/app/components/flowchart/**/*.spec.ts\" --include=\"src/app/services/flowchart-store.service.spec.ts\" --include=\"src/app/services/flowchart-export.service.spec.ts\" --include=\"src/app/models/flowchart.model.spec.ts\"",
    "test:notes": "ng test --watch=false --browsers=ChromeHeadless --include=\"src/app/services/content.service.spec.ts\" --include=\"src/app/components/user-notes/**/*.spec.ts\" --include=\"src/app/components/content-viewer/**/*.spec.ts\" --include=\"src/app/components/user-topic-list/**/*.spec.ts\" --include=\"src/app/home/**/*.spec.ts\"",
    "test:infra": "ng test --watch=false --browsers=ChromeHeadless --include=\"src/app/interceptors/**/*.spec.ts\" --include=\"src/app/core/**/*.spec.ts\" --include=\"src/app/services/theme.service.spec.ts\" --include=\"src/app/services/nav-history.service.spec.ts\" --include=\"src/app/components/back-button/**/*.spec.ts\" --include=\"src/app/components/theme-selector/**/*.spec.ts\"",
    "test:admin": "ng test --watch=false --browsers=ChromeHeadless --include=\"src/app/services/issue.service.spec.ts\" --include=\"src/app/pages/admin/**/*.spec.ts\" --include=\"src/app/components/report-issue/**/*.spec.ts\"",
    "test:rag": "ng test --watch=false --browsers=ChromeHeadless --include=\"src/app/services/rag.service.spec.ts\" --include=\"src/app/components/rag-assistant/**/*.spec.ts\"",
    "test:shell": "ng test --watch=false --browsers=ChromeHeadless --include=\"src/app/app.component.spec.ts\" --include=\"src/app/app.routes.spec.ts\" --include=\"src/app/services/seo.service.spec.ts\" --include=\"src/app/pages/landing/**/*.spec.ts\" --include=\"src/app/pages/user/**/*.spec.ts\"",
    "lint": "ng lint"
  },
