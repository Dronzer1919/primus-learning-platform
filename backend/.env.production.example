# ------------------------------------------------------------------
# Production environment for the Learning Platform backend.
# Copy this file to ".env" on the server and fill in real values:
#     cp .env.production.example .env && nano .env
# NEVER commit the real .env file.
# ------------------------------------------------------------------

# Server — port 3001 to coexist with the other project on this VPS (which uses 3000).
NODE_ENV=production
PORT=3001

# Database — isolated MongoDB running as the `lp-mongo` container in docker-compose.yml
# (its own container + volume + network; not exposed on the host).
MONGODB_URI=mongodb://lp-mongo:27017/learning_platform
# Alternatives:
#  - Atlas cloud: mongodb+srv://lp_user:PASSWORD@cluster.mongodb.net/learning_platform
#  - Native install (no Docker): mongodb://lp_user:PASSWORD@127.0.0.1:27017/learning_platform?authSource=learning_platform

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d

# CORS — the exact origin of your deployed frontend (comma-separated for multiple)
CORS_ORIGIN=https://primuscodex.com,https://www.primuscodex.com

# Google Sign-In (from Google Cloud Console → OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------
# Seeding only — `npm run seed` DELETES all users, topics and language tabs.
# It refuses to run without these, and refuses to run at all when
# NODE_ENV=production unless ALLOW_PRODUCTION_SEED=yes is also set.
# Leave these unset on a live server.
# ------------------------------------------------------------------
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=

# ------------------------------------------------------------------
# Notes on rate limiting (src/middleware/rateLimiters.js)
#   - Limits are per client IP and keyed off req.ip. That is only the real
#     client address because the app sets `trust proxy` and nginx forwards
#     X-Forwarded-For — keep the proxy_set_header lines in nginx-api.conf.
#   - Counters are in-process. ecosystem.config.js runs a single fork
#     instance, so this is correct as configured. If you switch to
#     exec_mode: 'cluster' or add a second container, each worker keeps its
#     own counters and the effective limit multiplies — move to a shared
#     store (rate-limit-redis) at that point.
# ------------------------------------------------------------------
