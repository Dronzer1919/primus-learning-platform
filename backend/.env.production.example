# ------------------------------------------------------------------
# Production environment for the Learning Platform backend.
# Copy this file to ".env" on the server and fill in real values:
#     cp .env.production.example .env && nano .env
# NEVER commit the real .env file.
# ------------------------------------------------------------------

# Server — port 3001 to coexist with the other project on this VPS (which uses 3000).
NODE_ENV=production
PORT=3001

# Database — isolated, self-hosted MongoDB on this VPS (see deployment-scripts/install-mongodb.sh).
# The lp_user account can only access the learning_platform DB.
MONGODB_URI=mongodb://lp_user:CHANGE_APP_PASSWORD@127.0.0.1:27017/learning_platform?authSource=learning_platform
# Alternative (MongoDB Atlas cloud):
# MONGODB_URI=mongodb+srv://lp_user:PASSWORD@cluster.mongodb.net/learning_platform

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d

# CORS — the exact origin of your deployed frontend (comma-separated for multiple)
CORS_ORIGIN=https://primuscodex.com,https://www.primuscodex.com

# Google Sign-In (from Google Cloud Console → OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
